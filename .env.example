# Copy to .env.local and fill in real values. Never commit .env.local.
# The same variables must be set in the Vercel project settings.

# --- Database -------------------------------------------------
# Neon pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth -----------------------------------------------------
# Generate with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public base URL of the app (http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"

# --- AI ----------------------------------------------------------------
# Google AI Studio key for Gemini. Optional: without it the app works and
# evaluations fail gracefully (retryable).
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional model override (default: gemini-3.8-flash).
GEMINI_MODEL=""
# Tests only: "1" uses a deterministic mock model. Refused in production.
AI_MOCK=""

# --- Seed (optional) ----------------------------------------------------
# If set, `npm run db:seed` creates (or promotes) this admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
