# Copy to .env.local and fill in real values. Never commit .env.local.
# The same variables must be set in the Vercel project settings.

# --- Database (Phase 1) -------------------------------------------------
# Neon pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (Phase 1) -----------------------------------------------------
# Generate with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public base URL of the app (http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"

# --- AI (Phase 2) -------------------------------------------------------
# Google AI Studio key for Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=""
